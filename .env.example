# data_agent environment example
# Copy to .env and fill in as needed. Per-user settings live in
# workspace/{userid}/config.json (isolated per SSO user or `local` in dev).

DATA_AGENT_HOST=0.0.0.0
DATA_AGENT_BACKEND_PORT=8000
DATA_AGENT_FRONTEND_PORT=6641
DATA_AGENT_DEFAULT_USER_ID=local
DATA_AGENT_CORS_ORIGINS=http://localhost:6641,http://127.0.0.1:6641

# LangGraph step cap per chat turn (default 9999; contract-guided analysis needs many tool steps)
# DATA_AGENT_RECURSION_LIMIT=9999

# Optional global fallbacks (overridden by per-user workspace config)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Organization MCP (Vertica) — loaded from .env.secrets, never sent to browser
# VERTICA_API_KEY=
# VERTICA_HOST=
# VERTICA_DATABASE=
# VERTICA_USER=
# VERTICA_PASSWORD=

# ---------------------------------------------------------------------------
# SSO (OAuth2/OIDC + PKCE via company login-portal → Microsoft Entra ID)
# Set OAUTH2_ENABLED=true in production. Dev: leave false for anonymous local user.
# Prerequisite: register client_id + redirect_uri in login-portal.
# ---------------------------------------------------------------------------
OAUTH2_ENABLED=true
OAUTH2_CLIENT_ID=bigdata-ontology-agent
OAUTH2_AUTHORIZE_URL=https://us-dev-mycis.synnex.org/login-portal/oauth2/aad/authorize
OAUTH2_TOKEN_URL=https://us-dev-mycis.synnex.org/login-portal/oauth2/token
OAUTH2_USERINFO_URL=https://us-dev-mycis.synnex.org/login-portal/oauth2/userinfo
OAUTH2_SCOPES=openid profile email
OAUTH2_REDIRECT_URI=http://bigdatauatgpu3.synnex.org:6641/api/auth/callback
OAUTH2_SESSION_SECRET=change-me-long-random-string
OAUTH2_FRONTEND_ORIGIN=http://bigdatauatgpu3.synnex.org:6641
OAUTH2_BUTTON_LABEL=Log in with Microsoft Entra
OAUTH2_COOKIE_SECURE=false
OAUTH2_IDLE_TIMEOUT_SECONDS=86400
